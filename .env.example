# Copy this file to `.env` and fill in your Gmail OAuth credentials.
# These are read at build/dev time by Vite (only VITE_-prefixed vars are exposed).

# From the Google Cloud Console → APIs & Services → Credentials.
VITE_GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GMAIL_CLIENT_SECRET=your-client-secret

# Fixed loopback port for the OAuth redirect. Whatever you set here, register
# http://127.0.0.1:<port> as an Authorized redirect URI on the OAuth client.
# Default is 8788 if unset.
VITE_OAUTH_REDIRECT_PORT=8788

# --- iPadOS / iOS -----------------------------------------------------------
# Create a SEPARATE OAuth client of type "iOS" (same Cloud project, so it
# shares the consent screen and test users). iOS clients are public — no
# secret — and authenticate with PKCE. The backend uses these automatically
# when the app runs on iOS.
VITE_GMAIL_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Custom URL scheme for the iOS redirect (redirect URI = <scheme>:/oauth2redirect).
# Defaults to the app's bundle id (com.subdigest.app), which you also register
# in the iOS Info.plist. You may instead use the reverse-client-id scheme
# (com.googleusercontent.apps.<ID>) if you prefer — just keep the two in sync.
VITE_GMAIL_IOS_REDIRECT_SCHEME=com.subdigest.app
