# Copy this file to `.env` and fill in your Gmail OAuth credentials.
# These are read at build/dev time by Vite (only VITE_-prefixed vars are exposed).

# From the Google Cloud Console → APIs & Services → Credentials.
VITE_GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GMAIL_CLIENT_SECRET=your-client-secret

# Fixed loopback port for the OAuth redirect. Whatever you set here, register
# http://127.0.0.1:<port> as an Authorized redirect URI on the OAuth client.
# Default is 8788 if unset.
VITE_OAUTH_REDIRECT_PORT=8788
